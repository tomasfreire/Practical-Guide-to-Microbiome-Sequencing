   "source": [
    "#First download the data files and group them in a folder https://www.ncbi.nlm.nih.gov/sra/?term=SRA022855"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 1,
   "id": "98cd520e",
   "metadata": {}
     ]
    }
   ],
   "source": [
    "import os\n",
    "import pandas as pd\n",
    "\n",
    "# Path to the folder where your sequence files are stored\n",
    "folder_path = '/Users/.../Location'  # Change this to the correct folder path\n",
    "\n",
    "# List all files in the folder\n",
    "files = os.listdir(folder_path)\n",
    "\n",
    "# Filter only .fastq.gz files (adjust if your filenames have different extensions)\n",
    "fastq_files = [f for f in files if f.endswith('.fastq.gz')]\n",
    "\n",
    "# Create a list to hold the metadata rows\n",
    "metadata = []\n",
    "\n",
    "# Loop over each file and create a metadata row\n",
    "for file in fastq_files:\n",
    "    # Extract the sample ID (e.g., SRR062670 from SRR062670.fastq.gz)\n",
    "    sample_id = file.split('.')[0]  # Assuming the sample ID is the part before .fastq.gz\n",
    "    \n",
    "    # You can add other metadata information here\n",
    "    # Example: assigning random values to body site and subject for demonstration\n",
    "    # You can replace these with actual data if available or read from another source\n",
    "    body_site = 'Unknown'  # You can update this based on your data\n",
    "    subject = 'Unknown'  # You can update this based on your data\n",
    "    \n",
    "    # Append the sample info to the metadata list\n",
    "    metadata.append([sample_id, body_site, subject])\n",
    "\n",
    "# Convert the list of metadata to a pandas DataFrame\n",
    "metadata_df = pd.DataFrame(metadata, columns=['#SampleID', 'BodySite', 'Subject'])\n",
    "\n",
    "# Write the metadata DataFrame to a .tsv file\n",
    "metadata_df.to_csv('sample-metadata.tsv', sep='\\t', index=False)\n",
    "\n",
    "print(\"Metadata file 'sample-metadata.tsv' has been generated.\")\n"
   ]
  },
